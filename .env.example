# Copy to .env for local runs. On GitHub, set these as repository secrets instead.

# Free token: sign up at travelpayouts.com, then Profile -> API token
TRAVELPAYOUTS_TOKEN=

# Gmail: use an app password (Google Account -> Security -> App passwords), not your normal password
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
ALERT_TO=you@gmail.com

# Optional tuning (defaults shown)
# ORIGINS=SFO,SJC
# MONTHS_AHEAD=10
# MIN_PCT_OFF=0.40
# MIN_DOLLARS_OFF=150
# MIN_SAMPLES=8
# MIN_HISTORY_DAYS=7      # a destination needs prices from this many different days
# MISTAKE_PCT_OFF=0.70
# MAX_STOPS=2
# HISTORY_DAYS=90         # lookback for a destination's normal price
# RAW_KEEP_DAYS=365       # keep individual prices this long (minimum 40)
# HISTORY_DIR=data/history  # where monthly summary CSVs are written
